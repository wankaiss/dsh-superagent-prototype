{
  "name": "dsh-superagent-panel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Standalone operator console for a locally running dsh-superagent (talks to the live management API through a loopback proxy).",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-dist.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.fixtures.json --noEmit",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@tanstack/react-query": "5.106.0",
    "@tanstack/react-router": "1.170.46",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "lucide-react": "1.68.0",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "tailwindcss": "4.3.4",
    "typescript": "^6.0.3",
    "vite": "8.3.5"
  }
}
